diff --git a/src/main/drivers/sdcard_sdio_baremetal.c b/src/main/drivers/sdcard_sdio_baremetal.c
index 83d292f..2f0b138 100644
--- a/src/main/drivers/sdcard_sdio_baremetal.c
+++ b/src/main/drivers/sdcard_sdio_baremetal.c
@@ -356,7 +356,7 @@ static bool sdcardSdio_poll(void)
                 if (sdcard.pendingOperation.callback) {
                     sdcard.pendingOperation.callback(SDCARD_BLOCK_OPERATION_WRITE, sdcard.pendingOperation.blockIndex, sdcard.pendingOperation.buffer, sdcard.pendingOperation.callbackData);
                 }
-            } else if (writeStatus != SD_BUSY || millis() > sdcard.operationStartTime + SDCARD_TIMEOUT_WRITE_MSEC) {
+            } else if (writeStatus != SD_BUSY || millis() - sdcard.operationStartTime > SDCARD_TIMEOUT_WRITE_MSEC) {
                 sdcard_reset();
 
                 if (sdcard.pendingOperation.callback) {
@@ -398,7 +398,7 @@ static bool sdcardSdio_poll(void)
                     sdcard.profiler(SDCARD_BLOCK_OPERATION_WRITE, sdcard.pendingOperation.blockIndex, micros() - sdcard.pendingOperation.profileStartTime);
                 }
 #endif
-            } else if (millis() > sdcard.operationStartTime + SDCARD_TIMEOUT_WRITE_MSEC) {
+            } else if (millis() - sdcard.operationStartTime > SDCARD_TIMEOUT_WRITE_MSEC) {
                 /*
                  * The caller has already been told that their write has completed, so they will have discarded
                  * their buffer and have no hope of retrying the operation. But this should be very rare and it allows
@@ -430,7 +430,7 @@ static bool sdcardSdio_poll(void)
                     }
                 break;
                 case SDCARD_RECEIVE_BLOCK_IN_PROGRESS:
-                    if (millis() <= sdcard.operationStartTime + SDCARD_TIMEOUT_READ_MSEC) {
+                    if (millis() - sdcard.operationStartTime <= SDCARD_TIMEOUT_READ_MSEC) {
                         break; // Timeout not reached yet so keep waiting
                     }
                     // Timeout has expired, so fall through to convert to a fatal error
@@ -458,7 +458,7 @@ static bool sdcardSdio_poll(void)
                     sdcard.profiler(SDCARD_BLOCK_OPERATION_WRITE, sdcard.pendingOperation.blockIndex, micros() - sdcard.pendingOperation.profileStartTime);
                 }
 #endif
-            } else if (millis() > sdcard.operationStartTime + SDCARD_TIMEOUT_WRITE_MSEC) {
+            } else if (millis() - sdcard.operationStartTime > SDCARD_TIMEOUT_WRITE_MSEC) {
                 sdcard_reset();
             }
         break;
diff --git a/src/test/unit/sdcard_sdio_unittest.cc b/src/test/unit/sdcard_sdio_unittest.cc
index 09fb71a..fa070d1 100644
--- a/src/test/unit/sdcard_sdio_unittest.cc
+++ b/src/test/unit/sdcard_sdio_unittest.cc
@@ -134,6 +134,42 @@ class SdcardSdioTest : public ::testing::Test {
 protected:
     uint8_t buffer[512];
 
+    void expectPendingAcrossRollover(sdcardState_e state, timeMs_t timeout)
+    {
+        const timeMs_t elapsedCases[] = {0, 1, timeout - 1, timeout};
+        for (timeMs_t elapsed : elapsedCases) {
+            SCOPED_TRACE(elapsed);
+            SetUp();
+            sdcard.state = state;
+            sdcard.operationStartTime = std::numeric_limits<timeMs_t>::max() - timeout / 2;
+            mockTimeMs = sdcard.operationStartTime + elapsed;
+            mockReadStatus = SD_BUSY;
+            mockWriteStatus = SD_BUSY;
+            mockCardReady = false;
+
+            EXPECT_FALSE(sdcardSdioVTable.sdcard_poll());
+            EXPECT_EQ(state, sdcard.state);
+            EXPECT_EQ(0u, initCalls);
+            EXPECT_EQ(0u, callbackCalls);
+        }
+    }
+
+    void expectExpiredAcrossRollover(sdcardState_e state, timeMs_t timeout, bool reportsFailure)
+    {
+        sdcard.state = state;
+        sdcard.operationStartTime = std::numeric_limits<timeMs_t>::max() - timeout / 2;
+        mockTimeMs = sdcard.operationStartTime + timeout + 1;
+        mockReadStatus = SD_BUSY;
+        mockWriteStatus = SD_BUSY;
+        mockCardReady = false;
+
+        EXPECT_FALSE(sdcardSdioVTable.sdcard_poll());
+        EXPECT_EQ(SDCARD_STATE_RESET, sdcard.state);
+        EXPECT_EQ(1u, initCalls);
+        EXPECT_EQ(reportsFailure ? 1u : 0u, callbackCalls);
+        EXPECT_EQ(nullptr, callbackBuffer);
+    }
+
     void SetUp() override
     {
         std::memset(&sdcard, 0, sizeof(sdcard));
@@ -333,3 +369,43 @@ TEST_F(SdcardSdioTest, FailedCsdReadRetriesOnNextPoll)
     EXPECT_TRUE(sdcardSdioVTable.sdcard_poll());
     EXPECT_EQ(SDCARD_STATE_READY, sdcard.state);
 }
+
+TEST_F(SdcardSdioTest, ReadRemainsPendingAcrossRollover)
+{
+    expectPendingAcrossRollover(SDCARD_STATE_READING, SDCARD_TIMEOUT_READ_MSEC);
+}
+
+TEST_F(SdcardSdioTest, ReadExpiresAfterRollover)
+{
+    expectExpiredAcrossRollover(SDCARD_STATE_READING, SDCARD_TIMEOUT_READ_MSEC, true);
+}
+
+TEST_F(SdcardSdioTest, DmaWriteRemainsPendingAcrossRollover)
+{
+    expectPendingAcrossRollover(SDCARD_STATE_SENDING_WRITE, SDCARD_TIMEOUT_WRITE_MSEC);
+}
+
+TEST_F(SdcardSdioTest, DmaWriteExpiresAfterRollover)
+{
+    expectExpiredAcrossRollover(SDCARD_STATE_SENDING_WRITE, SDCARD_TIMEOUT_WRITE_MSEC, true);
+}
+
+TEST_F(SdcardSdioTest, WriteCommitRemainsPendingAcrossRollover)
+{
+    expectPendingAcrossRollover(SDCARD_STATE_WAITING_FOR_WRITE, SDCARD_TIMEOUT_WRITE_MSEC);
+}
+
+TEST_F(SdcardSdioTest, WriteCommitExpiresAfterRollover)
+{
+    expectExpiredAcrossRollover(SDCARD_STATE_WAITING_FOR_WRITE, SDCARD_TIMEOUT_WRITE_MSEC, false);
+}
+
+TEST_F(SdcardSdioTest, MultiBlockStopRemainsPendingAcrossRollover)
+{
+    expectPendingAcrossRollover(SDCARD_STATE_STOPPING_MULTIPLE_BLOCK_WRITE, SDCARD_TIMEOUT_WRITE_MSEC);
+}
+
+TEST_F(SdcardSdioTest, MultiBlockStopExpiresAfterRollover)
+{
+    expectExpiredAcrossRollover(SDCARD_STATE_STOPPING_MULTIPLE_BLOCK_WRITE, SDCARD_TIMEOUT_WRITE_MSEC, false);
+}
